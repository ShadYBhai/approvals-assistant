# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model override (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Dev simulation mode — set to one of: timeout | error | malformed
# Leave blank (or unset) for real LLM calls
# LLM_SIMULATE=timeout

# API server port (default: 3001)
PORT=3001

# Web app origin for CORS (default: http://localhost:3000)
WEB_ORIGIN=http://localhost:3000

# Public env var for the web app to know the API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
